---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
  {
    label: 'Email',
    value: 'akimhm06@gmail.com',
    href: 'mailto:akimhm06@gmail.com',
  },
  {
    label: 'Instagram',
    value: '@akimhm_',
    href: 'https://instagram.com/akimhm_',
  },
  {
    label: 'Telegram',
    value: '@spederman0',
    href: 'https://t.me/spederman0',
  },
  {
    label: 'GitHub',
    value: 'ilhamoppo397-ui',
    href: 'https://github.com/ilhamoppo397-ui',
  },
];
---

<BaseLayout title="Kontak — Akim">
  <div class="container">
    <header class="page-header">
      <p class="page-label">Kontak</p>
      <h1>Hubungi gue</h1>
      <p class="page-lead">
        Terbuka untuk kolaborasi, wawancara, atau ngobrol soal crypto dan Web3.
      </p>
    </header>

    <ul class="contact-list">
      {contacts.map((c) => (
        <li>
          <a href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener">
            <span class="contact-label">{c.label}</span>
            <span class="contact-value">{c.value}</span>
            <span class="contact-arrow">→</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="note">
      <h2>Untuk kolaborasi</h2>
      <p>
        Kalo lu mau ngajak kolaborasi, wawancara, atau sekadar ngobrol soal
        crypto dan Web3, kirim email atau DM di Instagram. Gue cek tiap hari.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-12);
  }

  .page-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }

  .page-lead {
    font-size: 1.0625rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-16) 0;
    border-top: 1px solid var(--border-subtle);
  }

  .contact-list li {
    border-bottom: 1px solid var(--border-subtle);
  }

  .contact-list a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5, 1.25rem) 0;
    color: inherit;
    text-decoration: none;
    transition: padding 0.15s ease;
  }

  .contact-list a:hover {
    padding-left: var(--space-3);
    text-decoration: none;
  }

  .contact-list a:hover .contact-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  .contact-list a:hover .contact-value {
    color: var(--accent);
  }

  .contact-label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
    min-width: 90px;
  }

  .contact-value {
    flex: 1;
    font-size: 0.9375rem;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }

  .contact-arrow {
    color: var(--text-quaternary);
    font-size: 1rem;
    transition: all 0.15s ease;
  }

  .note {
    max-width: 560px;
  }

  .note h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .note p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .contact-label {
      min-width: 70px;
      font-size: 0.75rem;
    }
    .contact-value {
      font-size: 0.875rem;
      word-break: break-all;
    }
  }
</style>