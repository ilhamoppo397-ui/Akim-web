---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portofolio — Akim">
  <div class="container">
    <article class="page">
      <h1>Portofolio</h1>
      <p class="subtitle">Proyek yang sedang dan sudah gue kerjakan.</p>

      <div class="projects">
        <div class="project-card">
          <h3>Website Pribadi (akim.web.id)</h3>
          <p>Website yang sedang lu lihat ini. Dibuat dengan Astro v4 + HTML/CSS. Deploy di Vercel.</p>
          <span class="tag">Astro</span>
          <span class="tag">HTML/CSS</span>
        </div>

        <div class="project-card">
          <h3>Bot Trading Sederhana</h3>
          <p>Bot Python untuk memantau harga crypto di Binance dan kirim notifikasi ke Telegram.</p>
          <span class="tag">Python</span>
          <span class="tag">Binance API</span>
        </div>

        <div class="project-card">
          <h3>Catatan Kuliah Informatika</h3>
          <p>Kumpulan catatan algoritma, struktur data, dan basis data yang gue tulis selama kuliah.</p>
          <span class="tag">Markdown</span>
          <span class="tag">Catatan</span>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .subtitle {
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }
  .projects {
    display: grid;
    gap: 1.5rem;
  }
  .project-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .project-card h3 {
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .project-card p {
    margin-bottom: 1rem;
  }
  .tag {
    display: inline-block;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    margin-right: 0.5rem;
  }
</style>