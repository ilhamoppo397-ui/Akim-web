---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Portofolio — Akim">
  <div class="container">
    <header class="page-header">
      <p class="page-label">Portofolio</p>
      <h1>Yang sedang gue kerjakan</h1>
      <p class="page-lead">
        Proyek pribadi, eksperimen, dan catatan yang gue bangun sambil belajar.
      </p>
    </header>

    <section class="project-list">
      {projects.map((project) => (
        <article class="project">
          <div class="project-head">
            <h2>{project.name}</h2>
            <span class={`status status-${project.status.toLowerCase().replace(' ', '-')}`}>
              {project.status}
            </span>
          </div>

          <p class="project-desc">{project.description}</p>

          <div class="project-meta">
            <div class="meta-block">
              <span class="meta-label">Tentang</span>
              <p class="meta-value">{project.why}</p>
            </div>
            <div class="meta-block">
              <span class="meta-label">Yang gue pelajari</span>
              <p class="meta-value">{project.learned.join(' · ')}</p>
            </div>
          </div>

          <div class="project-tags">
            {project.tech.map((t) => <span class="tag">{t}</span>)}
          </div>

          {(project.github || project.demo) && (
            <div class="project-links">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener">GitHub →</a>
              )}
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noopener">Live Demo →</a>
              )}
            </div>
          )}
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-12);
  }
  .page-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }
  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }
  .page-lead {
    font-size: 1.0625rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .project {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }
  .project:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .project h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }

  .status {
    font-size: 0.6875rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    white-space: nowrap;
  }
  .status-live {
    background: rgba(16, 185, 129, 0.1);
    color: var(--positive);
  }
  .status-in-progress {
    background: rgba(79, 139, 255, 0.1);
    color: var(--accent);
  }
  .status-ongoing {
    background: rgba(245, 158, 11, 0.1);
    color: var(--warning);
  }

  .project-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .project-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .meta-block {
    padding-left: var(--space-4);
    border-left: 2px solid var(--border-default);
  }
  .meta-label {
    display: block;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-1);
    font-weight: 500;
  }
  .meta-value {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .project-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .project-links {
    display: flex;
    gap: var(--space-4);
    font-size: 0.8125rem;
  }
  .project-links a {
    color: var(--text-tertiary);
  }
  .project-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .project-meta {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .project-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>