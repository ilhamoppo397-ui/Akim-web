---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portofolio — Akim">
  <div class="container">
    <header class="page-header">
      <p class="page-label">Portofolio</p>
      <h1>Yang sedang gue kerjakan</h1>
      <p class="page-lead">
        Proyek pribadi, eksperimen, dan catatan yang gue bangun.
      </p>
    </header>

    <section class="project-list">
      <article class="project">
        <div class="project-head">
          <h2>akim.web.id</h2>
          <span class="project-status">Live</span>
        </div>
        <p>
          Website pribadi yang sedang lu lihat ini. Dibuat dengan Astro v4,
          HTML, dan CSS murni. Deploy di Vercel dengan auto-deploy dari GitHub.
        </p>
        <div class="project-tags">
          <span class="tag">Astro</span>
          <span class="tag">HTML/CSS</span>
          <span class="tag">Vercel</span>
        </div>
      </article>

      <article class="project">
        <div class="project-head">
          <h2>Bot Trading Sederhana</h2>
          <span class="project-status">In progress</span>
        </div>
        <p>
          Bot Python untuk memantau harga crypto di Binance dan kirim notifikasi
          ke Telegram saat kondisi tertentu terpenuhi.
        </p>
        <div class="project-tags">
          <span class="tag">Python</span>
          <span class="tag">Binance API</span>
          <span class="tag">Telegram Bot</span>
        </div>
      </article>

      <article class="project">
        <div class="project-head">
          <h2>Catatan Kuliah Informatika</h2>
          <span class="project-status">Ongoing</span>
        </div>
        <p>
          Kumpulan catatan algoritma, struktur data, dan basis data yang gue
          tulis selama kuliah. Ditulis dalam Markdown, di-host di GitHub.
        </p>
        <div class="project-tags">
          <span class="tag">Markdown</span>
          <span class="tag">GitHub</span>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-12);
  }

  .page-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    margin-bottom: var(--space-3);
    font-weight: 500;
  }

  .page-header h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }

  .page-lead {
    font-size: 1.0625rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .project {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .project h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }

  .project-status {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--positive);
    font-weight: 500;
  }

  .project p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .project-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }
</style>